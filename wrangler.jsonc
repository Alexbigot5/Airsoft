{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Workers Builds project name, otherwise CI overrides it on
  // every build and opens pull requests about the mismatch.
  "name": "airsoft",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",

  // Static files, including the bundled marketing page at public/index.html.
  // The Worker handles "/" itself so it can inject the site hook via
  // HTMLRewriter; every other asset path is served directly by Workers Assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airsoft-db",
      "database_id": "ab044189-3c7c-4849-b745-9067622a8b60",
      "migrations_dir": "migrations"
    }
  ],

  // Releases spots held by Checkout sessions that were never completed.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // This block is the only place these values should be edited.
  //
  // `wrangler deploy` deletes every var on the Worker and re-sets them from
  // here, so anything typed into the dashboard's "Variables and secrets" panel
  // survives only until the next deploy and then silently reverts to whatever
  // is written below. Editing there instead of here is how CONTACT_FROM came to
  // be one address in production and another in this file, with nothing to say
  // which one was live. Secrets are exempt -- a deploy never deletes those --
  // which is why RESEND_API_KEY, ADMIN_TOKEN and the Stripe keys are set with
  // `wrangler secret put` and are not here.
  "vars": {
    // Origin used to build links that leave the app (Stripe redirects, waiver
    // links). Leave empty to use the origin of the incoming request, which is
    // correct for both `wrangler dev` and workers.dev. Set it only when the
    // canonical origin differs from the one being served, e.g. behind a custom
    // domain you want every link to use -- as here.
    "PUBLIC_BASE_URL": "https://coyoteridgeairsoft.com",
    "WAIVER_VALID_DAYS": "365",
    "HOLD_MINUTES": "30",

    // Where the contact form delivers.
    "CONTACT_EMAIL": "coyoteridgeairsoft@gmail.com",

    // Must stay on a domain verified on the Resend account: Resend refuses
    // every send from anything else, and the refusal costs the field's
    // notification while the visitor is still told their message was received.
    //
    // Not a testing sender. Anything @resend.dev is Resend's shared sandbox,
    // which delivers only to the address that owns the Resend account -- so
    // pointing this at resend.dev while CONTACT_EMAIL is the field's Gmail
    // rejects every message with a 403, which is exactly what it did.
    "CONTACT_FROM": "Coyote Ridge Airsoft <help@coyoteridgeairsoft.com>"
  },

  "observability": {
    "enabled": true
  }
}
